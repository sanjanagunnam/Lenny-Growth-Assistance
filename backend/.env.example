# Database Configuration (PostgreSQL + pgvector or local SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_PORT=5432

# Ollama local LLM daemon
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_DEFAULT_MODEL=glm-5.3-flash
OLLAMA_TIMEOUT_SECONDS=120.0

# Cloud LLM Providers (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5-latest

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-flash-latest

GROQ_API_KEY=
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768

# RAG Ingestion & Retrieval Configuration
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
SIMILARITY_THRESHOLD=0.65
BATCH_SIZE=64
