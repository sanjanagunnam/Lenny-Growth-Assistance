# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lenny_growth
POSTGRES_PORT=5432

# Embedding Service Configuration
# Primary provider: 'ollama' | Fallback: 'openai'
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional OpenAI fallback (used when EMBEDDING_PROVIDER=openai or when Ollama is unavailable)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=768

# RAG Ingestion & Retrieval Configuration
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
SIMILARITY_THRESHOLD=0.65
BATCH_SIZE=64
