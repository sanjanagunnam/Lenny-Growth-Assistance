# Database connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@db:5432/lenny_growth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=lenny_growth
POSTGRES_PORT=5432

# Ollama local LLM daemon
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=15.0

# Anthropic Claude API (optional - defaults to Ollama if omitted)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# Default runtime configuration
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3.2
LOG_LEVEL=INFO

# RAG parameters
SIMILARITY_THRESHOLD=0.65
CHUNK_SIZE_TOKENS=1000
CHUNK_OVERLAP_TOKENS=150
